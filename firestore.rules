rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function expClaimAmount() { return 25; }
    function minClaimGapSeconds() { return 280; }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'seiiyvn5@gmail.com') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ─── USERS ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;

      // CREATE: hanya diri sendiri, role harus 'user', exp/level awal.
      // FIX: field role wajib diisi 'user' oleh AuthContext saat ensureUserDoc.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.exp == 0
                    && request.resource.data.level == 1;

      // UPDATE: admin boleh apa saja.
      // User biasa boleh update asalkan:
      //   1. Role tidak naik sendiri (harus sama dengan existing, atau jika
      //      dokumen lama belum punya field role, default-nya 'user').
      //   2. Perubahan adalah update profil biasa (exp/level tetap)
      //      ATAU klaim EXP (exp naik tepat expClaimAmount, level boleh naik 0–1).
      allow update: if isAdmin()
                    || (
                      isOwner(userId)
                      // Role tidak boleh diubah oleh user itu sendiri.
                      // Jika dokumen lama tidak punya field role, anggap 'user'.
                      && request.resource.data.role == (
                           'role' in resource.data ? resource.data.role : 'user'
                         )
                      && (
                           // Update profil biasa: exp & level tidak berubah
                           (request.resource.data.exp   == resource.data.exp
                            && request.resource.data.level == resource.data.level)
                           ||
                           // Klaim EXP
                           (request.resource.data.exp == resource.data.exp + expClaimAmount()
                            && request.resource.data.level >= resource.data.level
                            && request.resource.data.level <= resource.data.level + 1
                            && (!('updatedAt' in resource.data)
                                || request.time > resource.data.updatedAt + duration.value(minClaimGapSeconds(), 's')))
                         )
                    );
      allow delete: if false;
    }

    // ─── BOOKMARKS ────────────────────────────────────────────────────────────
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.listType in ['favorite', 'watchlist'];
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // ─── COMMENTS ─────────────────────────────────────────────────────────────
    // Komentar disimpan di Firestore (realtime via onSnapshot).
    // Foto profil di komentar diambil dari field photoURL user saat berkomentar.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // ─── WATCH HISTORY ────────────────────────────────────────────────────────
    match /watchHistory/{historyId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ─── KOMIK HISTORY ────────────────────────────────────────────────────────
    match /komikHistory/{historyId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ─── EXP LOG ─────────────────────────────────────────────────────────────
    match /expLog/{logId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.type in ['watchBlock', 'chapter']
                    && (request.resource.data.type != 'watchBlock'
                        || (request.resource.data.blockIndex is int
                            && request.resource.data.blockIndex >= 0));
      allow update, delete: if false;
    }

    // ─── GLOBAL CHAT ──────────────────────────────────────────────────────────
    match /globalChat/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // ─── DIRECT MESSAGES ──────────────────────────────────────────────────────
    match /dmChats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
                            && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/dmChats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.uid
                      && request.auth.uid in get(/databases/$(database)/documents/dmChats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ─── FOLLOWS ──────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.followerUid;
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.followerUid;
    }

    // ─── CUSTOM ANIME ─────────────────────────────────────────────────────────
    match /customAnime/{animeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                    && request.auth.token.email != null
                    && request.auth.token.email.lower() == 'seiiyvn5@gmail.com';
    }

    // ─── FRIEND REQUESTS ──────────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUid
                      || request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUid
                    && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.fromUid
                        || request.auth.uid == resource.data.toUid);
    }
  }
}
